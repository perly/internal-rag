generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DocumentStatus {
  active
  deleted
  error
}

enum DocumentOrigin {
  manual
  gdrive
}

enum Provider {
  gdrive
}

enum ConnectionStatus {
  active
  error
}

enum SyncRunStatus {
  running
  success
  error
}

model Document {
  id           String           @id @default(cuid())
  title        String
  body         String
  sourceUrl    String?
  contentHash  String
  status       DocumentStatus   @default(active)
  origin       DocumentOrigin   @default(manual)
  connectionId String?
  connection   Connection?      @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  externalId   String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  chunks       Chunk[]

  @@unique([connectionId, externalId])
  @@map("documents")
}

model Connection {
  id           String           @id @default(cuid())
  provider     Provider
  displayName  String
  credentials  String
  folderId     String?
  cursor       String?
  lastSyncAt   DateTime?
  status       ConnectionStatus @default(active)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  documents    Document[]
  syncRuns     SyncRun[]

  @@map("connections")
}

model SyncRun {
  id           String        @id @default(cuid())
  connectionId String
  connection   Connection    @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  startedAt    DateTime      @default(now())
  finishedAt   DateTime?
  status       SyncRunStatus
  createdCount Int           @default(0)
  updatedCount Int           @default(0)
  deletedCount Int           @default(0)
  error        String?

  @@map("sync_runs")
}

model Chunk {
  id          String                      @id
  documentId  String
  document    Document                    @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunkIndex  Int
  text        String
  contentHash String
  // Cosine and full-text indexes are created in the SQL migration. Prisma cannot represent them.
  embedding   Unsupported("vector(1536)")
  searchText  Unsupported("tsvector")     @default(dbgenerated("to_tsvector('english', text)"))

  @@unique([documentId, chunkIndex])
  @@map("chunks")
}

model ChatMessage {
  id            String   @id @default(cuid())
  question      String
  answer        String
  citedChunkIds String[]
  usedModel     Boolean
  createdAt     DateTime @default(now())

  @@map("chat_messages")
}
